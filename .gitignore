wads/
!wads/.gitkeep
build/
build-invariants/
build-perf/
node_modules/
*.wasm
*.wasm.map
.emscripten_cache/
tools/native-sanitize/obj/
tools/native-sanitize/out/
tools/native-sanitize/nat-doom
tools/native-sanitize/nat-doom-nosanity
tools/native-sanitize/nat-doom-cov
tools/native-sanitize/cov-obj/
# gcov output of tools/coverage/run-coverage.sh; regenerated, never committed
tools/coverage/report-*.json
.claude/
env.local
out/
# SoundFont bytes — never commit; fetched by tools/fetch-soundfont.sh
soundfonts/*.sf2
soundfonts/*.sf3
.harness-worktrees/
# 86Box runtime artifacts (created if 86Box is invoked without -P in repo root)
86box.cfg
nvr/
# per-leg logs kept by run-tests.sh when a leg fails
tools/.suite-logs/
# qemu-user core dumps (cross-arch experiments; see tools/freestanding/arm-check.sh)
qemu_*.core

# N64 gate scratch: per-demo ROMs (14 MB each) and ares logs, rebuilt every run.
tools/n64/n64_trace_work/

# Python bytecode caches: generated whenever compare.py is imported (the
# freestanding Makefile does), invalidated by any edit or interpreter bump.
# One was committed by accident in 6a5a930 and read by nothing.
__pycache__/
*.pyc
